# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (from Firebase Console > Project settings > Web App)
# Never place service account credentials or private keys in frontend client variables.
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="1:your-sender-id:web:your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ==============================================================================
# SERVER-ONLY CREDENTIALS (NEVER EXPOSE TO BROWSER CLIENT OR FRONTEND BUNDLE)
# ==============================================================================
# Pre-shared device authentication registry (JSON map of DeviceID -> SecretToken)
# Example token generation: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
FALLGUARD_DEVICE_CREDENTIALS='{"YOUR_DEVICE_ID":"YOUR_DEVICE_TOKEN"}'

# Optional for local development; required for Vercel device API writes.
# Obtain from Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_KEY=""
# Server-side Realtime Database URL; required in Vercel and copied from Realtime Database > Data.
FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"
# If Admin settings are omitted locally, the device API uses its in-memory test adapter.
